# ---------------------------------------------------------------------------
# Storefront — environment configuration
#
# Copy this file to `.env` and fill in the values you need.
# `.env` is git-ignored and must NEVER be committed.
#
# Only MONGODB_URI is required. Every integration below is optional and
# disabled by default; the app runs fully without any of them.
# ---------------------------------------------------------------------------

# --- Server --------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# --- Database (required) ------------------------------------------------
# A running MongoDB instance. Local default shown; use your own connection
# string in production.
MONGODB_URI=mongodb://127.0.0.1:27017/storefront

# --- Initial admin ----------------------------------------------------
# Used ONLY by `npm run seed`, and ONLY when the admins collection is empty:
# it creates the first super-admin whose login token is this value.
# Change it to a long random string, then rotate it from the admin panel.
INITIAL_ADMIN_TOKEN=change-this-to-a-long-random-token

# --- Uploaded file storage -------------------------------------------
# Where avatars / receipts / product images are written. On most container
# hosts the code directory is wiped on every deploy, so point this at a
# persistent disk/volume in production. Empty = default path inside the repo
# (fine for local development).
UPLOADS_ROOT=

# --- Notifications ------------------------------------------------------
# OTP codes and order updates go through server/lib/notifier.js. The default
# channel just logs to the console (no external service needed). To send real
# messages, implement a channel (SMS, email, push, ...) and register it with
# notifier.setChannel(). Nothing to configure here.

# --- Telegram admin bot (optional) ----------------------------------
# A full admin bot on the same Express app (webhook, no separate process).
# If TELEGRAM_BOT_TOKEN is empty the whole module stays disabled.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Random secret embedded in the webhook path — generate a long random string.
TELEGRAM_WEBHOOK_SECRET=change-this-to-a-long-random-string
# Public base URL of the service (no trailing slash) — only needed so the
# server can register the Telegram webhook on startup.
PUBLIC_BASE_URL=
# Numeric chat ids (comma-separated) that receive admin notifications and are
# treated as full super-admins by the bot. Get yours from @userinfobot.
TELEGRAM_ADMIN_CHAT_IDS=

# --- Admin reports / charts (optional) ------------------------------
# Off by default. Set to on / 1 / true to expose /admin/reports and its API.
REPORTS_ENABLED=off

# --- Database backup tool (optional) -------------------------------
# Guards the /dev/db/backup page and its API with a single static token,
# separate from the admin login. Empty = the page and API return 404.
DB_BACKUP_TOKEN=
# Where backup .zip files are written. Empty = server/backups (local dev only).
DB_BACKUP_ROOT=
